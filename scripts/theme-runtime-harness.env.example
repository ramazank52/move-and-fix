# Copy outside the repository to a local, isolated development-only environment.
# Do not put any production host, database identifier, credential or secret here.
NODE_ENV=development
HARNESS_ENVIRONMENT=development
HARNESS_ALLOW_STAGING=0
THEME_HARNESS_RUN_ID=theme-replace-with-uuid-suffix
PREVIEW_URL=http://127.0.0.1:8081
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
DATABASE_URL=mysql://root@127.0.0.1:4000/theme_audit_replace_with_run_id
THEME_HARNESS_VISUAL_BACKEND=NOT_CONFIGURED
